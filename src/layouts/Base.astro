---
import { site } from '../site.config.mjs';
import { SECTION_LABELS } from '../lib/data.js';
import Logo from '../components/Logo.astro';
import '@fontsource/poppins/600.css';
import '@fontsource/poppins/700.css';
import '../styles/global.css';
const { title, description = site.tagline, noindex = false, wide = false } = Astro.props;
const fullTitle = title ? `${title} | ${site.name}` : site.name;
const canonical = new URL(Astro.url.pathname, site.url).href;
const nav = [['/start-here/', 'Start here'], ...['guides', 'best', 'comparisons', 'reviews'].map((k) => [`/${k}/`, SECTION_LABELS[k]]), ['/free-plans/', 'Free plans']];
const here = Astro.url.pathname;
---
<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>{fullTitle}</title>
  <meta name="description" content={description} />
  <link rel="canonical" href={canonical} />
  <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
  <meta name="theme-color" content="#0f3d3e" />
  {noindex && <meta name="robots" content="noindex" />}
  <meta property="og:title" content={fullTitle} />
  <meta property="og:description" content={description} />
  <meta property="og:url" content={canonical} />
  <meta property="og:type" content="website" />
  <meta property="og:image" content={new URL('/og.png', site.url).href} />
  <meta name="twitter:card" content="summary_large_image" />
  <link rel="sitemap" href="/sitemap-index.xml" />
  <slot name="head" />
</head>
<body>
  <header class="site-header">
    <div class="wrap header-inner">
      <a class="brand" href="/"><Logo /><span>{site.name}</span></a>
      <nav aria-label="Main">
        {nav.map(([href, label]) => <a href={href} aria-current={here.startsWith(href) ? 'page' : undefined}>{label}</a>)}
      </nav>
    </div>
  </header>
  <slot name="hero" />
  <main class:list={['wrap', { narrow: !wide }]}><slot /></main>
  <footer class="site-footer">
    <div class="wrap footer-inner">
      <div>
        <a class="brand" href="/"><Logo /><span>{site.name}</span></a>
        <p>{site.tagline}</p>
      </div>
      <div>
        <h4>Explore</h4>
        <a href="/start-here/">Start here</a><a href="/free-plans/">Free plans compared</a><a href="/tools/">All tools</a><a href="/alternatives/">Alternatives</a>
      </div>
      <div>
        <h4>About</h4>
        <a href="/about/">About</a><a href="/contact/">Contact</a><a href="/affiliate-disclosure/">Affiliate disclosure</a><a href="/privacy/">Privacy</a><a href="/cookies/">Cookies</a>
      </div>
    </div>
    <p class="wrap fine">Some links on this site are advertising links marked “(ad)”. © {new Date().getFullYear()} {site.name}</p>
  </footer>
  <script is:inline>
    // Pass the visit source to /go/ links so clicks can be attributed. Reads only the current URL and referrer; stores nothing.
    (function () {
      var q = new URLSearchParams(location.search);
      var src = q.get('utm_source');
      if (!src && document.referrer) { try { var h = new URL(document.referrer).hostname; if (h !== location.hostname) src = h; } catch (e) {} }
      var camp = q.get('utm_campaign');
      if (!src && !camp) return;
      document.querySelectorAll('a.aff').forEach(function (a) {
        var u = new URL(a.href);
        if (src) u.searchParams.set('src', src);
        if (camp) u.searchParams.set('c', camp);
        a.href = u.toString();
      });
    })();
  </script>
</body>
</html>
