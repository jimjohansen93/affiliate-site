---
// Every affiliate link goes through /go/<slug>/ so the URL can be changed in one place
// (src/data/products.json) and clicks can be counted. Each link carries its own ad label,
// as recommended by Forbrukertilsynet and the FTC.
import { getProduct } from '../lib/data.js';
const { slug, label, button = false } = Astro.props;
const p = getProduct(slug);
---
<a class:list={['aff', { btn: button, small: button }]} href={`/go/${p.slug}/`} rel="sponsored nofollow noopener" target="_blank" data-product={p.slug}>{label ?? p.name}</a><span class="ad-label" aria-label="advertising link">(ad)</span>
