---
// Three stacked blocks = "the stack". Uses currentColor + accent so it works on light and dark backgrounds.
const { size = 30 } = Astro.props;
---
<svg width={size} height={size} viewBox="0 0 32 32" aria-hidden="true">
  <rect x="4" y="21" width="24" height="7" rx="2.5" fill="currentColor" />
  <rect x="7" y="12.5" width="18" height="7" rx="2.5" fill="currentColor" opacity=".72" />
  <rect x="10" y="4" width="12" height="7" rx="2.5" fill="var(--accent)" />
</svg>
