---
import Base from '../../layouts/Base.astro';
import Disclosure from '../../components/Disclosure.astro';
import ProductCard from '../../components/ProductCard.astro';
import { getArticles, getProduct } from '../../lib/data.js';
import { render } from 'astro:content';
import { site } from '../../site.config.mjs';
export async function getStaticPaths() {
  return (await getArticles()).map((entry) => ({ params: { section: entry.data.section, slug: entry.id }, props: { entry } }));
}
const { entry } = Astro.props;
const { Content } = await render(entry);
const d = entry.data;
const items = d.products.map(getProduct);
const faqLd = d.faq.length ? JSON.stringify({ '@context': 'https://schema.org', '@type': 'FAQPage', mainEntity: d.faq.map((f) => ({ '@type': 'Question', name: f.q, acceptedAnswer: { '@type': 'Answer', text: f.a } })) }) : null;
const articleLd = JSON.stringify({ '@context': 'https://schema.org', '@type': 'Article', headline: d.title, description: d.description,
  datePublished: d.published?.toISOString(), dateModified: (d.updated ?? d.published)?.toISOString(),
  author: { '@type': 'Organization', name: site.name, url: site.url }, publisher: { '@type': 'Organization', name: site.name } });
---
<Base title={d.seoTitle ?? d.title} description={d.description} noindex={d.draft}>
  <script slot="head" type="application/ld+json" set:html={articleLd} />
  {faqLd && <script slot="head" type="application/ld+json" set:html={faqLd} />}
  {d.draft && <p class="draft-banner">DRAFT – not published. Needs human review and first-hand testing.</p>}
  <article>
    <p class="kicker"><a href={`/${d.section}/`}>{d.section}</a></p>
    <h1>{d.title}</h1>
    {items.length > 0 && <Disclosure />}
    <p class="byline">By {site.name}{d.updated && ` · Updated ${d.updated.toISOString().slice(0, 10)}`}{d.reviewedBy && ` · Tested by ${d.reviewedBy}`}</p>
    <Content />
    {items.length > 0 && (<><h2>Tools in this article</h2><div class="grid">{items.map((p) => <ProductCard product={p} />)}</div></>)}
    {d.faq.length > 0 && (<section class="faq"><h2>FAQ</h2>{d.faq.map((f) => <details><summary>{f.q}</summary><p>{f.a}</p></details>)}</section>)}
  </article>
</Base>
